---
// src/components/Timeline.astro
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;

const items = headings
  .filter((h) => h.depth === 2)
  .map((h) => {
    const i = h.text.indexOf("·");
    return i > -1
      ? { slug: h.slug, date: h.text.slice(0, i).trim(), title: h.text.slice(i + 1).trim() }
      : { slug: h.slug, date: "", title: h.text };
  });
---

{items.length > 1 && (
  <nav class="updates-box not-prose" aria-label="Updates">
    <p class="ub-title">Updates</p>
    <ol>
      {items.map((it) => (
        <li>
          <a href={`#${it.slug}`}>
            {it.date && <span class="ub-date">{it.date}</span>}
            <span class="ub-text">{it.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .updates-box { background:#23272b; color:#e6e6e6; border-radius:8px;
    padding:20px 24px; margin:24px 0; font-size:.9rem; }
  .ub-title { margin:0 0 12px; font-weight:700; color:#fff; }
  ol { list-style:none; margin:0; padding:0 0 0 18px; border-left:2px solid #4a5056; }
  li { position:relative; margin:0; padding:6px 0 6px 14px; }
  li::before { content:''; position:absolute; left:-24px; top:14px; width:10px; height:10px;
    border-radius:50%; background:#e6e6e6; box-shadow:0 0 0 3px #23272b; }
  a { display:block; color:#e6e6e6; text-decoration:none; }
  a:hover .ub-text { color:#fff; text-decoration:underline; }
  .ub-date { display:block; font-size:.78rem; color:#9aa0a6; }
  .ub-text { display:block; font-weight:600; line-height:1.3; }
</style>